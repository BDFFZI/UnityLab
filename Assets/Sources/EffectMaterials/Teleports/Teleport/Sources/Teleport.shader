				float3 Specular = 0.5;
				float Metallic = 0;
				float Smoothness = 0.8;
				float Occlusion = 1;
				float Alpha = Alpha25;
				float AlphaClipThreshold = 0.5;
				float AlphaClipThresholdShadow = 0.5;
