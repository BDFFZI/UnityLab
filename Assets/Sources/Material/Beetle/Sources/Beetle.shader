				float3 tanToWorld1 = float3( WorldTangent.y, WorldBiTangent.y, WorldNormal.y );
				float3 tanToWorld2 = float3( WorldTangent.z, WorldBiTangent.z, WorldNormal.z );
				float3 tanNormal81 = UnpackNormalScale( tex2D( _NormalMap, uv_NormalMap ), 1.0f );
				float3 worldNormal81 = float3( dot( tanToWorld0, tanNormal81 ), dot( tanToWorld1, tanNormal81 ), dot( tanToWorld2, tanNormal81 ) );
				float3 NormalWS82 = worldNormal81;
