			half4 frag(PackedVaryings input
						#ifdef ASE_DEPTH_WRITE_ON
						,out float outputDepth : ASE_SV_DEPTH
						#endif
						 ) : SV_Target
			{
				UNITY_SETUP_INSTANCE_ID( input );
				UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX( input );

				#if defined(ASE_NEEDS_FRAG_WORLD_POSITION)
					float3 WorldPosition = input.positionWS;
				#endif

				float4 ShadowCoords = float4( 0, 0, 0, 0 );
				float4 ClipPos = input.clipPosV;
				float4 ScreenPos = ComputeScreenPos( input.clipPosV );

				#if defined(ASE_NEEDS_FRAG_SHADOWCOORDS)
					#if defined(REQUIRES_VERTEX_SHADOW_COORD_INTERPOLATOR)
						ShadowCoords = input.shadowCoord;
					#elif defined(MAIN_LIGHT_CALCULATE_SHADOWS)
						ShadowCoords = TransformWorldToShadowCoord( WorldPosition );
					#endif
				#endif

				Gradient gradient32 = NewGradient( 0, 3, 2, float4( 0, 0, 0, 0 ), float4( 0.7058824, 0.2825595, 0, 0.6176547 ), float4( 1, 0.7468275, 0.1137255, 1 ), 0, 0, 0, 0, 0, float2( 1, 0 ), float2( 1, 1 ), 0, 0, 0, 0, 0, 0 );
				float simplePerlin3D27 = snoise( input.ase_texcoord3.xyz*( _NoiseScale * 2.0 ) );
				simplePerlin3D27 = simplePerlin3D27*0.5 + 0.5;
				float Time106 = _CustomTime;
				float simplePerlin3D11 = snoise( ( ( simplePerlin3D27 * 0.5 ) + ( input.ase_texcoord3.xyz + ( _Speed * Time106 ) ) )*_NoiseScale );
				simplePerlin3D11 = simplePerlin3D11*0.5 + 0.5;
				float Noise38 = simplePerlin3D11;
				float3 ase_viewVectorWS = ( _WorldSpaceCameraPos.xyz - WorldPosition );
				float3 ase_viewDirWS = normalize( ase_viewVectorWS );
				float3 ase_normalWS = input.ase_texcoord4.xyz;
				float fresnelNdotV44 = dot( ase_normalWS, ase_viewDirWS );
				float fresnelNode44 = ( 0.1 + 1.0 * pow( 1.0 - fresnelNdotV44, 3.0 ) );
				float grayscale37 = Luminance(SampleGradient( gradient32, ( Noise38 + fresnelNode44 ) ).rgb);
				float simplePerlin2D47 = snoise( ( input.ase_texcoord3.xyz + ( Time106 * 10.0 ) ).xy*0.1 );
				simplePerlin2D47 = simplePerlin2D47*0.5 + 0.5;
				float lerpResult51 = lerp( simplePerlin2D47 , 1.0 , 0.5);
				float lerpResult60 = lerp( lerpResult51 , (cos( Time106 )*0.5 + 0.5) , 0.8);
				float Flicker63 = lerpResult60;
				float dotResult75 = dot( _Direction , ase_normalWS );
				float simplePerlin3D85 = snoise( ( input.ase_normal + Time106 ) );
				simplePerlin3D85 = simplePerlin3D85*0.5 + 0.5;
				float smoothstepResult98 = smoothstep( 0.6 , 0.9 , saturate( ( dotResult75 - ( simplePerlin3D85 * 0.3 ) ) ));
				float DirectionMask81 = smoothstepResult98;
				

				float Alpha = saturate( ( ( pow( grayscale37 , 0.5 ) * Flicker63 ) + DirectionMask81 ) );
				float AlphaClipThreshold = 0.5;
				float AlphaClipThresholdShadow = 0.5;

				#ifdef ASE_DEPTH_WRITE_ON
					float DepthValue = input.positionCS.z;
				#endif

				#ifdef _ALPHATEST_ON
					#ifdef _ALPHATEST_SHADOW_ON
						clip(Alpha - AlphaClipThresholdShadow);
					#else
						clip(Alpha - AlphaClipThreshold);
					#endif
				#endif

				#if defined(LOD_FADE_CROSSFADE)
