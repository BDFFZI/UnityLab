			half4 frag ( PackedVaryings input
						#ifdef ASE_DEPTH_WRITE_ON
						,out float outputDepth : ASE_SV_DEPTH
						#endif
						#ifdef _WRITE_RENDERING_LAYERS
						, out float4 outRenderingLayers : SV_Target1
						#endif
						 ) : SV_Target
			{
				UNITY_SETUP_INSTANCE_ID(input);
				UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX(input);

				#if defined(LOD_FADE_CROSSFADE)
					LODFadeCrossFade( input.positionCS );
				#endif

				float3 WorldPosition = input.positionWS;
				float3 WorldViewDirection = GetWorldSpaceNormalizeViewDir( WorldPosition );
				float4 ShadowCoords = float4( 0, 0, 0, 0 );
				float4 ClipPos = input.clipPosV;
				float4 ScreenPos = ComputeScreenPos( input.clipPosV );

				float2 NormalizedScreenSpaceUV = GetNormalizedScreenSpaceUV(input.positionCS);

				#if defined(ASE_NEEDS_FRAG_SHADOWCOORDS)
					#if defined(REQUIRES_VERTEX_SHADOW_COORD_INTERPOLATOR)
						ShadowCoords = input.shadowCoord;
					#elif defined(MAIN_LIGHT_CALCULATE_SHADOWS)
						ShadowCoords = TransformWorldToShadowCoord( WorldPosition );
					#endif
				#endif

				Gradient gradient32 = NewGradient( 0, 3, 2, float4( 0, 0, 0, 0 ), float4( 0.7058824, 0.2825595, 0, 0.6176547 ), float4( 1, 0.7468275, 0.1137255, 1 ), 0, 0, 0, 0, 0, float2( 1, 0 ), float2( 1, 1 ), 0, 0, 0, 0, 0, 0 );
				float simplePerlin3D27 = snoise( input.ase_texcoord6.xyz*( _NoiseScale * 2.0 ) );
				simplePerlin3D27 = simplePerlin3D27*0.5 + 0.5;
				float Time106 = _CustomTime;
				float simplePerlin3D11 = snoise( ( ( simplePerlin3D27 * 0.5 ) + ( input.ase_texcoord6.xyz + ( _Speed * Time106 ) ) )*_NoiseScale );
				simplePerlin3D11 = simplePerlin3D11*0.5 + 0.5;
				float Noise38 = simplePerlin3D11;
				float3 ase_normalWS = input.ase_texcoord7.xyz;
				float fresnelNdotV44 = dot( ase_normalWS, WorldViewDirection );
				float fresnelNode44 = ( 0.1 + 1.0 * pow( 1.0 - fresnelNdotV44, 3.0 ) );
				float4 color101 = IsGammaSpace() ? float4(3.698113,0.8601168,0.08721964,0) : float4(17.76464,0.7107843,0.008152617,0);
				float dotResult75 = dot( _Direction , ase_normalWS );
				float simplePerlin3D85 = snoise( ( input.ase_normal + Time106 ) );
				simplePerlin3D85 = simplePerlin3D85*0.5 + 0.5;
				float smoothstepResult98 = smoothstep( 0.6 , 0.9 , saturate( ( dotResult75 - ( simplePerlin3D85 * 0.3 ) ) ));
				float DirectionMask81 = smoothstepResult98;
				float4 lerpResult99 = lerp( ( _Intensity * SampleGradient( gradient32, ( Noise38 + fresnelNode44 ) ) ) , float4( color101.rgb , 0.0 ) , ( DirectionMask81 * 0.4 ));
				
				float grayscale37 = Luminance(SampleGradient( gradient32, ( Noise38 + fresnelNode44 ) ).rgb);
				float simplePerlin2D47 = snoise( ( input.ase_texcoord6.xyz + ( Time106 * 10.0 ) ).xy*0.1 );
				simplePerlin2D47 = simplePerlin2D47*0.5 + 0.5;
				float lerpResult51 = lerp( simplePerlin2D47 , 1.0 , 0.5);
				float lerpResult60 = lerp( lerpResult51 , (cos( Time106 )*0.5 + 0.5) , 0.8);
				float Flicker63 = lerpResult60;
				
				float3 BakedAlbedo = 0;
				float3 BakedEmission = 0;
				float3 Color = lerpResult99.rgb;
				float Alpha = saturate( ( ( pow( grayscale37 , 0.5 ) * Flicker63 ) + DirectionMask81 ) );
				float AlphaClipThreshold = 0.5;
				float AlphaClipThresholdShadow = 0.5;

				#ifdef ASE_DEPTH_WRITE_ON
					float DepthValue = input.positionCS.z;
				#endif

				#ifdef _ALPHATEST_ON
					clip(Alpha - AlphaClipThreshold);
				#endif

				InputData inputData = (InputData)0;
				inputData.positionWS = WorldPosition;
				inputData.viewDirectionWS = WorldViewDirection;

				#ifdef ASE_FOG
					inputData.fogCoord = InitializeInputDataFog(float4(inputData.positionWS, 1.0), input.fogFactorAndVertexLight.x);
				#endif
				#ifdef _ADDITIONAL_LIGHTS_VERTEX
					inputData.vertexLighting = input.fogFactorAndVertexLight.yzw;
				#endif

				inputData.normalizedScreenSpaceUV = NormalizedScreenSpaceUV;

				#if defined(_DBUFFER)
					ApplyDecalToBaseColor(input.positionCS, Color);
				#endif

				#ifdef ASE_FOG
					#ifdef TERRAIN_SPLAT_ADDPASS
						Color.rgb = MixFogColor(Color.rgb, half3(0,0,0), inputData.fogCoord);
					#else
						Color.rgb = MixFog(Color.rgb, inputData.fogCoord);
					#endif
				#endif

				#ifdef ASE_DEPTH_WRITE_ON
					outputDepth = DepthValue;
				#endif

				#ifdef _WRITE_RENDERING_LAYERS
					uint renderingLayers = GetMeshRenderingLayer();
					outRenderingLayers = float4( EncodeMeshRenderingLayer( renderingLayers ), 0, 0, 0 );
				#endif

				return half4( Color, Alpha );
			}
			ENDHLSL
